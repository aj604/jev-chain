{
  "name": "jevchain-trace-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The jevchain run visualization: trace graph, why panel, inspector, timeline and the pure trace helpers behind them.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/lib/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./trace.css": "./src/trace.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "jevchain": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jevchain-examples": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
